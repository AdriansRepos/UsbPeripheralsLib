<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>UsbPeripheralsLib</Title>
    <Authors>AdriansRepos</Authors>
    <Description>A lightweight, production-ready .NET Class Library designed to easily manage USB mass storage devices and perform safe file exports.</Description>
    <PackageProjectUrl>https://github.com/AdriansRepos/UsbPeripheralsLib</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdriansRepos/UsbPeripheralsLib</RepositoryUrl>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <PackageReleaseNotes>Added full printing and document ecosystem.</PackageReleaseNotes>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>	
</Project>
